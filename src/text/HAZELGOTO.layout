# How Apple's editor stored HAZELGOTO.TEXT on APPLE3 (finding 288).
dle
# Not SYSTEM.EDITOR's page zero: its environment sits 142 bytes later than
# HEADER puts it, and the 16 bytes set before it are nothing HEADER has.
# Recorded as bytes, not named.
environment 256
defined 2
autoindent 1
filling 0
tokdef 1
lmargin 0
rmargin 79
paramargin 5
runoffch ^
created 3-29-79
lastused 3-29-79
byte 224 1
byte 226 1
byte 228 1
byte 230 1
byte 232 1
byte 234 1
byte 236 1
byte 238 1
byte 240 1
byte 242 1
byte 244 1
byte 246 1
byte 248 1
byte 250 1
byte 252 1
byte 254 1
literal 1
expect 1 (*$U-*)
